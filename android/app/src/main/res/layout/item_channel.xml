<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="8dp"
    android:layout_marginBottom="6dp">

    <TextView
        android:id="@+id/ch_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CH0"
        android:textColor="@color/tianyi_blue"
        android:textStyle="bold"
        android:minWidth="40dp" />

    <View
        android:id="@+id/ch_swatch"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_swatch" />

    <Spinner
        android:id="@+id/ch_func"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp" />

    <Button
        android:id="@+id/ch_pick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/apply_color"
        android:textSize="12sp"
        android:minHeight="0dp"
        android:background="@drawable/bg_btn_ghost"
        android:textColor="@color/tianyi_blue"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="8dp" />
</LinearLayout>
