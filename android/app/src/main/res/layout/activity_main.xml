<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/tianyi_blue_very_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 头部 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/tianyi_blue"
                android:gravity="center" />

            <TextView
                android:id="@+id/slogan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slogan"
                android:textSize="14sp"
                android:textColor="@color/tianyi_blue"
                android:gravity="center"
                android:paddingTop="4dp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 连接卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/conn_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/not_connected"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:gravity="center_vertical" />

                <Button
                    android:id="@+id/btn_scan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_ghost"
                    android:text="@string/scan"
                    android:textColor="@color/tianyi_blue"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_connect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_primary"
                    android:text="@string/connect"
                    android:textColor="@color/white"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp"
                    android:enabled="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/device_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_device"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:paddingTop="8dp" />
        </LinearLayout>

        <!-- CSV 导入卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_csv"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tianyi_blue_dark" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="10dp">

                <Button
                    android:id="@+id/btn_pick_csv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_ghost"
                    android:text="@string/pick_csv"
                    android:textColor="@color/tianyi_blue"
                    android:minWidth="0dp"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_upload_play"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:text="@string/upload_play"
                    android:textColor="@color/white"
                    android:minWidth="0dp"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp"
                    android:enabled="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/csv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_csv"
                android:textSize="12sp"
                android:textColor="@color/tianyi_blue"
                android:textStyle="bold"
                android:paddingTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/csv_hint"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- 播放控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center">

            <Button
                android:id="@+id/btn_play"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:text="@string/play"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:text="@string/stop"
                android:textColor="@color/tianyi_blue"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:text="@string/next"
                android:textColor="@color/tianyi_blue"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- 亮度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brightness"
                android:textColor="@color/text_primary" />

            <SeekBar
                android:id="@+id/seek_bright"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/bright_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="@color/tianyi_blue"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 通道标题 -->
        <TextView
            android:id="@+id/lbl_channels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/channel"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/tianyi_blue"
            android:paddingTop="18dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/channels_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 色盘标题 -->
        <TextView
            android:id="@+id/lbl_palette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tianyi_palette"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/tianyi_blue"
            android:paddingTop="14dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击色块应用到全部通道并发送"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/palette_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" />

        <!-- 日志 -->
        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:paddingTop="14dp"
            android:paddingBottom="8dp" />
    </LinearLayout>
</ScrollView>
